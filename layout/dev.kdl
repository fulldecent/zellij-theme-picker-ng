layout {
    pane size=1 borderless=true {
        plugin location="tab-bar"
    }
    pane
    pane size=1 borderless=true {
        plugin location="status-bar"
    }
    floating_panes {
        pane name="Themes" focus=true x="10%" y="8%" width="80%" height="75%" {
            plugin location="file:./target/wasm32-wasip1/debug/plugin.wasm"
        }
    }
}
